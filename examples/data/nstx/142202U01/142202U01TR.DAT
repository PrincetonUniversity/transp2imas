!
! Isolver regression test.  Start run with ohmic coil fixed at 20 keV and the
! other coils adjusted for minimum current.  q profile evolved for inductive
! coupling.  Ohmic coil feedeback to match plasma current.  PID voltage sources
! drive the coils.
!

 RPLOT_ITEM(1) = "CPDIS"
 RPLOT_ITEM(2) = "IPCMP"
 RPLOT_ITEM(3) = "LBPOL"
 RPLOT_ITEM(4) = "ISOITER"

 !NISO_VERBOSE=0

 NISO_DEF_DRIVE_TYPE=4
 FB_NAMES = 'vver','vhor','voh'

 NPFC_JIT=2

 PFC_NAMES    = 'OH'
 PFC_NAMES(2) = 'PF1AU'
 PFC_NAMES(3) = 'PF2U'
 PFC_NAMES(4) = 'PF3U'
 PFC_NAMES(5) = 'PF5'
 PFC_NAMES(6) = 'PF3L'
 PFC_NAMES(7) = 'PF2L'
 PFC_NAMES(8) = 'PF1B'
 PFC_NAMES(9) = 'PF1AL'

 PROBE_NAMES = '@all'

 PFC_CUR(1)   = 20000.     ! oh initial value
 PFC_SIGMA(1) = 100.       ! small error

 XISO_JIT_RELAX=.005       ! start small, use update_time to restore to nominal
 XISO_JIT_MINFRAC = 0.6	   ! fast relaxation during early time steps
 
 NLISODIF = .TRUE.

 NEQ_XGUESS = -1

 ISO_CONFIG='pass'

 PASS_NAMES = '@pass'

 XISO_SMOOTH = 2.5d-2

 !XISO_RELBAL    = 5.E-4
 !XISO_RELBAL_DT = 2.E-4

 XBDYCHK  = 0.
 BDY_YFIX = 0.

 NLPCUR   = .FALSE.
 NLINDUCT = .TRUE.

DTMAXG=0.001
DTMAXB=0.002
DTMAXT=0.002

NBI_PSERVE=1
! ------------------------------------------------------------------------------------
! template namelist for NSTX data prep.
! Lines with commets containing !-> are expected to be changed from the data prep code.
! -------------------------------------------------------------------------------------
 
NSHOT=142202 !-> <shot>	!**** DATA SHOT NUMBER
 
NZONES=50    ! RGA, 06Jun2009, increased from default 20
 
!
! CALCULATION TIME LIMITS
!
!TINIT=1.5d-2 !-> <toi-0.03>  	!**** START TIME
TINIT=.015
FTIME=0.54   !-> <toi>  	!**** STOP TIME
FTIME_OK = 0.52
TBONMIN=1.5d-2 !-> <toi-0.03>	!**** MINIMUM BEAM TURN ON TIME
 
!
NSYZF2= 2       !  TBT
 
!
!--------------------------
FTEMIN=10.0
 
!DTMAXG=0.005
 
NMOM=16
LEVTRK=2
LEVGEO=12
LEVGB=3
 
!
! PLASMA COMPOSITION:
!
AIMP=12.
XZIMP=6.
APLASM=1.,2.    !* 1ST SPECIES, 2ND SPECIES (IF ANY) ATOMIC WTS.
BACKZ=1.,1.
XZEFFI=2.0	   !* PLASMA COMPOSITION ZEFF
NLZFIM=.FALSE.
NLZEFM=.false.    !* SET .TRUE. FOR PC ZEFF = MAGDIF ZEFF
NLZFIN=.false.    !* SET .TRUE. TO READ ZEFF(T) DATA
NLZFI2=.false.
NLZFXI=.TRUE.
XPZEFF=0.0
 
!
!  INITIAL CONDITIONS
!
NG=2        !INITIAL NUMBER OF HYDROGENIC SPECIES
FRAC=0.0,1.00    !SPECIES FRACTIONS (IF NG=2)
GFRAC=0.0,1.00
FTITE=.9       !INITIAL GUESS AT TI = FTITE * TE
 
!
!  OUTPUT (GENERATION OF PLOTS)
!
NGMAX=2         !* MAX NO. OF HYDROGENIC SPECIES = 1 **
 NLNBI_TEST_OUT = .FALSE.
SEDIT=0.001
STEDIT=0.001
 
!
! PTCL BALANCE MODEL
!
NMODEL=1            !USE (1) CONST. FRAC (2) CONST V OR (3) CONST D PTCL MODEL
TAUPH=2*0.15        !* PTCL CONFINEMENT TIME
TAUPO=0.15          !* IMPURITY CONFINEMENT TIME
RFRAC=0.00,0.9
 
!
! ION CONDUCTIVITY MODEL
!

XKFMIN=0.01
NLXKIE=.false.
XKFAC=1.            !* ANOMOLOUS MULTIPLIER FOR N.C. KAPA(I)
NLFXKF=.false.      !*** ADJUST XKFAC TO FIT MEASURED TI IF .TRUE.
NLTIF0=.FALSE.
nlti2=.true.
nlti2tx=.true.
nltipro=.true.
fiefac=1.0
!tixlim=.85
!tidxsw=0.1
!tifacx=1.0
nlvphi=.true.
nlntx=.true.
alph0i=0.6
alph0e=0.6
NLPCX=.F           ! PASSIVE CX IS SCE OF TI DATA FOR XKFAC ADJ.
NCHPCX=1           ! WHICH CX EFLUX CHORD
NSPPCX=1           ! WHICH EFLUX SPECIES
 
!-----------------------------------------------------------------
!  "FISH-BONE" CONTROLS
NLFBON=.false.      !*.TRUE. TO TURN ON "FISH-BONES"
TFSHON=0.465       !*TIME OF FIRST FISHBONE
TFSHOF=0.500       !*TIME OF LAST FISHBONE
FSHPER=1.0e-3      !*FISHBONE PERIOD (CYCLE) TIME
FSHWID=1.0e-3      !*FISHBONE WIDTH (DURATION OF EACH "BONE")
FBEMIN=0.0         !*MIN ENERGY OF BEAM PTCLS AFFECTED BY FISHBONES
FBEMAX=2.0e4       !*MAX ENERGY OF BEAM PTCLS AFFECTED BY FISHBONES
FVPVMX=0.25        !*MAX VPAR/V OF BEAM PTCLS AFFECTED BY FISHBONES
FVPVMN=0.0         !*MIN VPAR/V OF BEAM PTCLS AFFECTED BY FISHBONES
FBLTIM=5.0e-5      !*AVG LOSS TIME OF FISHBONED BEAM PTCLS (VERY SHORT)
!------------------------------------------------------------------
!  FAST ION Diffusion Model
!
NMDIFB=0
BDIFB=0.0
CDIFB=0.0
TDIFBA=0.100,0.495,1.00
BDIFBA=0.0E4,0.0E4,3.0E4
CDIFBA=0.0E4,0.0E4,3.0E4
EDIFBE=30000.,45000.,90000.
FDIFBE=1.0,1.0,1.0
 
!
! MAGNETICS MODELING
!
NLSPIZ=.f      !* .T TO USE SPITZER INSTEAD OF N.C. RESISTIVITY
NLMDIF=.t      !-> <mdiff>     !**** .T TO SOLVE POLOIDAL FIELD DIFFUSION EQN., ELSE .F
NLBOOT=.t      !* =.T TO INCLUDE BOOTSTRAP CURRENTS
NEFLD=3
RQEFLD=0.0
QEFLD=20.0   
NLVSUR=.f
NLQDATA=.f     !-> <qdata>	   !**** .F if solving poloidal field diffusion eqn., ELSE .T
NLDFLX=.T      !-> <dflx>	   !**** .T if diamag flux exists, ELSE .F
NLBCCW=.FALSE.
NLJCCW=.TRUE.
 
!
!NCLASS Controls
!
NCMODEL=2
NLVWNC=.TRUE.
NLBOOTW=.TRUE.
NLETAW =.TRUE.

NLTINC=.TRUE.
NLSQUEEZ=.FALSE.
NLNCSMOO=.TRUE.
TAUSMNNC=0.020
TAUSMTNC=0.020
XSMN_NC=0.100
XSMT_NC=0.100
 
!---- SAUTER Controls
!NLRES_SAU=.TRUE.
!NLBOOT_SAU=.TRUE.
 
!
! NEUTRALS MODEL - SEE ALSO PTCL BALANCE
!
NSOMOD=1      ! SELECT 1 FOR FRANTIC, 8 FOR SORCE8
MOD0ED=1      ! =2 TO SET HOT EDGE NEUT TEMP=CONST. FRAC OF CENTRAL TI
TI0FRC=.033333   ! T0(A)=TI0FRC*TI(0) IF MOD0ED=2
E0IN=20., 2*.025, 20., 2*.025  ! T0(A) FOR COLD SCES, HOT SCES IF MOD0ED=1
FH0ESC=.3       ! FRAC. OF ESC. NEUTRALS REFLECTED TO PLASMA "HOT"
 
!
!
NZNBMR=13
 
!
!  DATA HANDLING
!
NRITER=3       ! EXPECT 2-SIDED SYMMETRIZABLE TE PROFILE DATA IF =3
NRINER=3       ! EXPECT 2-SIDED SYMMETRIZABLE NE PROFILE DATA IF =3
nriti2=4
nriomg=4
NRINIM=4
!NRIZF2=6
NRIQPR=5	!VS SQRT(TOROIDAL FLUX)
NRIGRB=5
NRIPRS=5
NRID2F=5
!nrizf2=3
NRIBOL=3
NSYTER=1       ! IF =1 SYMMETRIZE TE DATA WITH 2R CHORD FIT
NSYNER=3       ! IF =2 SYMMETRIZE NE DATA WITH IN/OUT AVG
nsyti2=0
nsyomg=0
NSYNIM=0
NSYQPR=0
!NSYZF2=0
nsybol=2
 
NLMICW=.F      ! .T TO RENORM NE(R) IN TRANSP (NORMALLY DONE IN TRDAT)
NLPFIN=.F      ! .T TO READ PASSIVE CX TI FIT LIMS FOR SELECTED CHORD
NLPXIN=.F      ! .T TO READ PASSIVE CX XSECT DATA FOR SELECTED CHORD
PRFAC=0.0      !* FRACTION OF CX EFLUX TOT POWER TO SUBTRACT FROM BOLO.
 
!
!  TRDAT NAMELIST
!
$TRDATA
