NRITER=1       ! EXPECT 2-SIDED SYMMETRIZABLE TE PROFILE DATA IF =3
NRINER=1       ! EXPECT 2-SIDED SYMMETRIZABLE NE PROFILE DATA IF =3
NRITI2=1
NRIVP2=1
NRINIM=1	!one-sided, outboard data vs. R
NRIBOL=3
