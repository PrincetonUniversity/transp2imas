!to calculate ion temperature assuming neoclassical...
NLTI2TX=.F.
!NLTI2 = .T
!NLTIPRO=.TRUE.
NKIMOD=4    !* SELECT KAPA(I) N.C. FIT MODEL
!XKFMIN=0.01
!to calculate ion diffusivity using input ion temperature data
FTITE=.9       !INITIAL GUESS AT TI = FTITE * TE
NLXKIE=.false.
XKFAC=1.			!ANOMOLOUS MULTIPLIER FOR N.C. KAPA(I)
NLFXKF=.false.		!ADJUST XKFAC TO FIT MEASURED TI IF .TRUE.
NLTIF0=.FALSE.
fiefac=1.0
!alph0i=0.6
!alph0e=0.6
NLPCX=.F           ! PASSIVE CX IS SCE OF TI DATA FOR XKFAC ADJ.
NCHPCX=1           ! WHICH CX EFLUX CHORD
NSPPCX=1           ! WHICH EFLUX SPECIES
NLNTX=.true.	   ! READ NEUTRON FILE
