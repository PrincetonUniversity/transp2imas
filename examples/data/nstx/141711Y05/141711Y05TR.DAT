NLOMGVTR=.T     ! .T: rotation data inputs OMG or VP2 refer
NLBOOTW=.T      ! .T: use NCLASS bootstrap current
XL1NCJBS=0.1    ! r/a for bootstrap smoothing; default XL1NCJBS=0.1
NLETAW=.T       ! .T: use NCLASS resistivity
XL1NCETA=0.0    ! r/a for eta smoothing; default XL1NCJBS=0.0
NLVWNC=.F       ! .T: compute NCLASS radial electrostatic potential profile
NLSQUEEZ=.T     ! .T for "squeezing factor" correction
NLTINC=.T       ! .T to use Tx/Tmj, i.e. impurity temperature
NLNCSMOO=.T     ! .T to activate smoothing of temp & density
TAUSMNNC=0.050  ! smoothing convolution time (tau) for densities
TAUSMTNC=0.050  ! smoothing convolution time (tau) for temperatures
XSMN_NC=0.050   ! radial smoothing half width for densities (r/a units)
XSMT_NC=0.050   ! radial smoothing half width for temperatures (r/a units)
NLSAW_NC=.T     ! .T to reinitialize time convolutions at each sawtooth
!-------PLASMA ZEFF-----------------------------------------------------
AIMP=12.
XZIMP=6.
NLZFIM=.FALSE.
NLZEFM=.false.    !* SET .TRUE. FOR PC ZEFF = MAGDIF ZEFF
NLZFIN=.FALSE.    !* SET .TRUE. TO READ ZEFF(T) DATA
NLZFXI=.TRUE.	!use 2-d carbon density to calculate Zeff
!-------MAGNETICS MODELING----------------------------------------------
NLDFLX=.FALSE.
NQMODA=4	!use input q(R), then switch to current diffusion
NQMODB=1	!2 means NLVSUR=.T
TQMODA=2.40	!use current diffusion after 0.16s
TAUQMOD=0.010	!10ms transition time
NLSPIZ=.F      !* .T TO USE SPITZER INSTEAD OF N.C. RESISTIVITY
NLRES_SAU=F
NLMDIF=.F      ! .T TO SOLVE POLOIDAL FIELD DIFFUSION EQN.
NLBOOT=.TRUE.      !* =.T TO INCLUDE BOOTSTRAP CURRENTS
NLQDATA=.true.
NMODPOH = 2
!-------PLASMA COMPOSITION:----------------------------------------------
NGMAX=1
NG=1        		!INITIAL NUMBER OF HYDROGENIC SPECIES
APLASM=2.    	!* 1ST SPECIES, 2ND SPECIES (IF ANY) ATOMIC WTS.
BACKZ=1.
FRAC=1.0     !SPECIES FRACTIONS (IF NG=2)
RFRAC=1.0
NDEFINE=0,0,0
!-------PTCL BALANCE MODEL----------------------------------------------
NMODEL=1    !USE (1) CONST. FRAC (2) CONST V OR (3) CONST D PTCL MODEL
TAUPH=2*.060    !* PTCL CONFINEMENT TIME
TAUPO=.060      !* IMPURITY CONFINEMENT TIME
!-------NEUTRALS MODEL - SEE ALSO PTCL BALANCE--------------------------
NSOMOD=1      ! SELECT 1 FOR FRANTIC, 8 FOR SORCE8
MOD0ED=2      ! =2 TO SET HOT EDGE NEUT TEMP=CONST. FRAC OF CENTRAL TI
TI0FRC=.033333   ! T0(A)=TI0FRC*TI(0) IF MOD0ED=2
E0IN=20., 2*3., 20., 2*3.  ! T0(A) FOR COLD SCES, HOT SCES IF MOD0ED=1
FH0ESC=.3       ! FRAC. OF ESC. NEUTRALS REFLECTED TO PLASMA "HOT"
!-------EFLUX MODEL-----------------------------------------------------
NLEFLX=.FALSE.      !* .T FOR NEUTRAL EFLUX CALCULATION
!-------SYSTEM DIMENSIONS-----------------------------------------------
RMAJOR=100.0    !MAJOR RADIUS OF PLASMA, PBX USUALLY SUPPLIES PPS DATA
RMINOR=10.0     !MINOR RADIUS - PBX USUALLY SUPPLIES THRU PHYSICS DATA
!-------OUTPUT, PLOTS-----------------------------------------------------
