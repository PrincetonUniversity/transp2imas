 &END
! Time switching
 &PT_SOLVER
! PTRANSP
! - PTRANSP solver selection
!  o Interprative (=0) or PT_SOLVER (=3)
 lpredictive_mode = 3
!
! - PTRANSP equation selection
!  o Choose what profile variables to predict.  These are
!    Te, Ti, angular momentum, electron density, main-ion
!    density, impurity density.  Only Te, Ti are supported with GLF23
!    Defaults should be Te, Ti.
!    Over-ridden below with the usage of update_time.
 lpredict_te = 0
 lpredict_ti = 0
 lpredict_pphi = 0
 lpredict_ne = 0
 lpredict_nmain = 0
 lpredict_nimp = 0
 PT_TEMPLATE='uu_pt.nml'

!
! - PTRANSP transport region boundaries
!  o Define three regions as axial, confinement and near-edge.
!    We specify the transport model for each region.
!    Here XI is rho sqrt. normalized toroidal flux.  The
!    regions have boundaries XIMIN_CONF and XIMAX_CONF
!    where axial is from 0.0->XMIN_CONF
!    and confinement is from XMIN_CONF->XMAX_CONF
!    and near-edge is from XMAX_CONF-> X*BOUND.
!    Typically BOUND=1.0 from the equilibrium UFILES.
!  o Define minimum xi for confinement.  0.0 = axis.
 XIMIN_CONF = 0.0
!  o Define maximum xi for confinement.  1.0 = separatrix.
!    Typically use 0.8
 XIMAX_CONF = 0.8
!
!  o Here I explicitly define the boundaries for temperature
!    angular momentum and density.  These should be less than
!    or equal to XIMAX_CONF
 XIBOUND = 0.8
 XPHIBOUND = 0.8
 XNBOUND = 0.8
!
! - Boundary conditions for temperature prediction
!  o For Te and Ti, set the boundary to be one of
!    the following:
!    = 3 ! Use experimental Te for XI > XIBOUND
!    = 4 ! Use experimental Ti for XI > XIBOUND
!    = 5 ! Use PEDESTAL model or namelist controls
!          for XI > XIBOUND
!  o Set Te boundary condtion
 MODEEDG = 3
!  o Set Ti boundary condtion.
 MODIEDG = 4
!
! - Boundary condition for rotation prediction (undocumented)
!  o Set omega boundary according to
!    = 2 use OMEDG (constant)
!    = 3 use OMEGA input data
 MODOMEDG = 3
!
!  o Initial timestep to obtain power balance (default=1e-5)
 DTINIT = 1e-05
!
 &END
 &TGLF
 TGLF_TEMPLATE='tglf2.nml'
!   o number of poloidal modes in the high-k spectrum of TGLF_TM
 NKY = 12
!   o Scaing factor for diamagnetic terms to ExB shear
 ALPHA_DIA = 0.0
!   o Output multi-dimensional frequency and growthrate spectrum
 NLGROWTH_TGLF = .True.
 &END
~update_time = 2.87
lpredict_te = 1
lpredict_ti = 1
lpredict_ne = 0
lpredict_pphi = 0
