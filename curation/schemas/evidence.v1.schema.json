{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transp2imas:curation:evidence.v1",
  "title": "Curation evidence sidecar transp2imas.curation.inputs.v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "transp2imas.curation.inputs.v1"
    },
    "assessment_window": {
      "$ref": "urn:transp2imas:curation:common#/$defs/assessment_window"
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "electron_temperature",
          "ion_temperature",
          "electron_density",
          "rotation",
          "composition",
          "heating"
        ]
      },
      "additionalProperties": {
        "$ref": "urn:transp2imas:curation:common#/$defs/evidence_record_v1"
      }
    },
    "thresholds": {
      "$ref": "urn:transp2imas:curation:common#/$defs/thresholds"
    },
    "composition": {
      "$ref": "urn:transp2imas:curation:common#/$defs/composition"
    },
    "input_expectations": {
      "type": "array",
      "items": {
        "$ref": "urn:transp2imas:curation:common#/$defs/input_expectation_v1"
      }
    },
    "gradient_uncertainties": {
      "$ref": "urn:transp2imas:curation:common#/$defs/gradient_uncertainties"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
